# Frontend environment configuration
# Set your API base URL (e.g., https://api.example.com or http://localhost:3001/api)
REACT_APP_API_BASE_URL=http://localhost:3001/api
# WebSocket endpoint for notifications (e.g., ws://localhost:3001/ws or wss://api.example.com/ws)
REACT_APP_WS_URL=ws://localhost:3001/ws
# Optional SSO Provider authorization URL (placeholder)
REACT_APP_SSO_PROVIDER_URL=https://sso.example.com/authorize
# Brand name for top bar and titles
REACT_APP_BRAND_NAME=Ocean LMS
